+// --- BOX64_AESTRACE diagnostic instrumentation -----------------------------
+// Enabled only when env var BOX64_AESTRACE is set. Adds zero overhead
+// otherwise. Cross-checks the table-based MixColumns/InvMixColumns against
+// the naive ff_mult() formula (kept in comments above) and dumps state
+// in/out for the AES-NI software-fallback path (used when the host ARM CPU
+// lacks the Crypto Extension, i.e. cpuext.aes==0). See box64 issue #4206:
+// SteamCMD/Steam TLS handshakes fail on such hosts unless BOX64_AES=0 forces
+// the guest to avoid AES-NI opcodes entirely. This instrumentation is meant
+// to determine whether the software fallback computes wrong bytes (a math
+// bug in this file) or is fed wrong bytes by the dynarec-generated glue code
+// around the CALL (a register-cache/JIT-wiring bug), which the math alone
+// cannot reveal.
+static int box64_aestrace_flag = -1;
+static int box64_aestrace(void)
+{
+    if(box64_aestrace_flag<0)
+        box64_aestrace_flag = getenv("BOX64_AESTRACE")?1:0;
+    return box64_aestrace_flag;
+}
+static void box64_aes_dump(const char* tag, int xmm, sse_regs_t* before, sse_regs_t* after)
+{
+    if(!box64_aestrace())
+        return;
+    fprintf(stderr, "[AESTRACE] %-10s xmm%-2d in=", tag, xmm);
+    for(int i=0; i<16; ++i) fprintf(stderr, "%02x", before->ub[i]);
+    fprintf(stderr, " out=");
+    for(int i=0; i<16; ++i) fprintf(stderr, "%02x", after->ub[i]);
+    fprintf(stderr, "\n");
+}
+static void box64_aes_check_mc(const char* tag, sse_regs_t* in, sse_regs_t* out, int inv)
+{
+    if(!box64_aestrace())
+        return;
+    sse_regs_t ref;
+    for(int j=0; j<4; ++j) {
+        if(inv) {
+            ref.ub[0+j*4] = ff_mult(0x0E, in->ub[0+j*4]) ^ ff_mult(0x0B, in->ub[1+j*4]) ^ ff_mult(0x0D, in->ub[2+j*4]) ^ ff_mult(0x09, in->ub[3+j*4]);
+            ref.ub[1+j*4] = ff_mult(0x09, in->ub[0+j*4]) ^ ff_mult(0x0E, in->ub[1+j*4]) ^ ff_mult(0x0B, in->ub[2+j*4]) ^ ff_mult(0x0D, in->ub[3+j*4]);
+            ref.ub[2+j*4] = ff_mult(0x0D, in->ub[0+j*4]) ^ ff_mult(0x09, in->ub[1+j*4]) ^ ff_mult(0x0E, in->ub[2+j*4]) ^ ff_mult(0x0B, in->ub[3+j*4]);
+            ref.ub[3+j*4] = ff_mult(0x0B, in->ub[0+j*4]) ^ ff_mult(0x0D, in->ub[1+j*4]) ^ ff_mult(0x09, in->ub[2+j*4]) ^ ff_mult(0x0E, in->ub[3+j*4]);
+        } else {
+            ref.ub[0+j*4] = ff_mult(0x02, in->ub[0+j*4]) ^ ff_mult(0x03, in->ub[1+j*4]) ^               in->ub[2+j*4]  ^               in->ub[3+j*4] ;
+            ref.ub[1+j*4] =               in->ub[0+j*4]  ^ ff_mult(0x02, in->ub[1+j*4]) ^ ff_mult(0x03, in->ub[2+j*4]) ^               in->ub[3+j*4] ;
+            ref.ub[2+j*4] =               in->ub[0+j*4]  ^               in->ub[1+j*4]  ^ ff_mult(0x02, in->ub[2+j*4]) ^ ff_mult(0x03, in->ub[3+j*4]);
+            ref.ub[3+j*4] = ff_mult(0x03, in->ub[0+j*4]) ^               in->ub[1+j*4]  ^               in->ub[2+j*4]  ^ ff_mult(0x02, in->ub[3+j*4]);
+        }
+    }
+    if(memcmp(&ref, out, 16)) {
+        fprintf(stderr, "[AESTRACE] %s MISMATCH table-vs-naive! in=", tag);
+        for(int i=0; i<16; ++i) fprintf(stderr, "%02x", in->ub[i]);
+        fprintf(stderr, " table_out=");
+        for(int i=0; i<16; ++i) fprintf(stderr, "%02x", out->ub[i]);
+        fprintf(stderr, " naive_out=");
+        for(int i=0; i<16; ++i) fprintf(stderr, "%02x", ref.ub[i]);
+        fprintf(stderr, "\n");
+    }
+}
+// --- end BOX64_AESTRACE instrumentation -------------------------------------
